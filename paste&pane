<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ArtisManager PRO - Gestionale Forni & Pasticcerie</title>
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { user-select: none; -webkit-user-select: none; }
  </style>
</head>
<body class="bg-gray-950 text-white font-sans antialiased selection:bg-amber-500 selection:text-black">
  <div id="root"></div>

  <script type="text/babel">
    const { useState } = React;

    function ArtisManagerApp() {
      const [activeTab, setActiveTab] = useState('orders');
      
      const [incomingOrders, setIncomingOrders] = useState([
        {
          id: 'ORD-8492',
          customer: 'Marco Rossi',
          phone: '3331234567',
          product: 'Torta di Compleanno Personalizzata',
          date: '2026-11-20',
          time: '16:00',
          status: 'Da quotare',
          price: '',
          notes: 'Scritta di augurio: "Buon Compleanno Marco" con decori al cioccolato.',
          isPaid: false
        },
        {
          id: 'ORD-8493',
          customer: 'Sara Bianchi',
          phone: '3389876543',
          product: 'Vassoio Pasticceria Mista (1.5 kg)',
          date: '2026-11-21',
          time: '10:30',
          status: 'In attesa di pagamento',
          price: '42.00',
          notes: 'Senza glutine se possibile, o comunque assortimento misto classico.',
          isPaid: false
        },
        {
          id: 'ORD-8490',
          customer: 'Giuseppe Verdi',
          phone: '3471122334',
          product: 'Pane Artigianale a Lievito Madre',
          date: '2026-11-19',
          time: '08:30',
          status: 'Confermato & Pagato',
          price: '12.50',
          notes: '3 pagnotte grandi ben cotte.',
          isPaid: true
        }
      ]);

      const [selectedOrder, setSelectedOrder] = useState(null);
      const [priceInput, setPriceInput] = useState('');

      const handleOpenQuoteModal = (ord) => {
        setSelectedOrder(ord);
        setPriceInput(ord.price || '');
      };

      const handleSavePrice = (e) => {
        e.preventDefault();
        if (!priceInput) return;

        setIncomingOrders(incomingOrders.map(ord => {
          if (ord.id === selectedOrder.id) {
            return {
              ...ord,
              price: priceInput,
              status: 'In attesa di pagamento'
            };
          }
          return ord;
        }));

        setSelectedOrder(null);
        setPriceInput('');
      };

      const handleSimulatePayment = (id) => {
        setIncomingOrders(incomingOrders.map(ord => {
          if (ord.id === id) {
            return {
              ...ord,
              status: 'Confermato & Pagato',
              isPaid: true
            };
          }
          return ord;
        }));
      };

      return (
        <div className="min-h-screen bg-gray-950 text-gray-100 flex flex-col md:flex-row">
          
          {/* SIDEBAR PER PC / HEADER FISSO PER MOBILE */}
          <aside className="w-full md:w-72 bg-gray-900 border-b md:border-b-0 md:border-r border-gray-800 p-4 md:p-6 flex flex-col justify-between shrink-0">
            <div className="space-y-6">
              <div className="flex items-center space-x-3">
                <div className="w-12 h-12 bg-amber-500 text-gray-950 rounded-2xl font-black text-xl flex items-center justify-center shadow-lg shadow-amber-500/20">🍞</div>
                <div>
                  <h1 className="font-extrabold text-base text-white tracking-tight">ArtisManager PRO</h1>
                  <span className="text-xs text-amber-400 font-medium">Gestionale Forni & Pasticcerie</span>
                </div>
              </div>

              <div className="bg-amber-500/10 border border-amber-500/30 p-3 rounded-2xl">
                <span className="text-[10px] text-amber-300 font-bold uppercase tracking-wider block">Negozio Attivo</span>
                <span className="text-sm font-bold text-white">🏪 Pasticceria Centrale</span>
              </div>

              {/* MENU DI NAVIGAZIONE (Adattivo PC/Mobile) */}
              <nav className="flex md:flex-col space-x-2 md:space-x-0 md:space-y-2 overflow-x-auto">
                <button 
                  onClick={() => setActiveTab('orders')}
                  className={`flex items-center space-x-3 w-full px-4 py-3 rounded-2xl font-bold text-xs md:text-sm transition text-left ${activeTab === 'orders' ? 'bg-amber-500 text-gray-950 shadow-lg shadow-amber-500/20' : 'bg-gray-800/50 hover:bg-gray-800 text-gray-300'}`}
                >
                  <span className="text-lg">📥</span>
                  <span>Preordini & Notifiche</span>
                </button>
                <button 
                  onClick={() => setActiveTab('agenda')}
                  className={`flex items-center space-x-3 w-full px-4 py-3 rounded-2xl font-bold text-xs md:text-sm transition text-left ${activeTab === 'agenda' ? 'bg-amber-500 text-gray-950 shadow-lg shadow-amber-500/20' : 'bg-gray-800/50 hover:bg-gray-800 text-gray-300'}`}
                >
                  <span className="text-lg">📋</span>
                  <span>Agenda Laboratorio</span>
                </button>
                <button 
                  onClick={() => setActiveTab('settings')}
                  className={`flex items-center space-x-3 w-full px-4 py-3 rounded-2xl font-bold text-xs md:text-sm transition text-left ${activeTab === 'settings' ? 'bg-amber-500 text-gray-950 shadow-lg shadow-amber-500/20' : 'bg-gray-800/50 hover:bg-gray-800 text-gray-300'}`}
                >
                  <span className="text-lg">⚙️</span>
                  <span>Configurazione Negozio</span>
                </button>
              </nav>
            </div>

            <div className="hidden md:block pt-6 border-t border-gray-800 text-[11px] text-gray-500">
              ArtisManager Cloud v2.4 • Pronto per il business artigianale.
            </div>
          </aside>

          {/* CONTENUTO PRINCIPALE (Ottimizzato PC e Cellulare) */}
          <main className="flex-1 p-4 md:p-8 overflow-y-auto max-w-6xl mx-auto w-full">

            {/* SEZIONE 1: PREORDINI */}
            {activeTab === 'orders' && (
              <div className="space-y-6">
                <div className="flex flex-col md:flex-row md:items-center justify-between gap-2 border-b border-gray-800 pb-4">
                  <div>
                    <h2 className="text-xl font-black text-white">Gestione Preordini in Arrivo</h2>
                    <p className="text-xs text-gray-400">Ricevi le richieste, quantifica i prezzi e incassa in anticipo.</p>
                  </div>
                  <div className="bg-gray-900 border border-gray-800 px-3 py-1.5 rounded-xl text-xs font-bold text-amber-400 w-fit">
                    Totale Ordini: {incomingOrders.length}
                  </div>
                </div>

                {/* Griglia Ordini (Su PC si dispongono magnificamente a griglia o elenco espanso) */}
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {incomingOrders.map(ord => (
                    <div key={ord.id} className="bg-gray-900 border border-gray-800 hover:border-gray-700 rounded-3xl p-5 space-y-4 shadow-xl flex flex-col justify-between transition">
                      <div className="space-y-3">
                        <div className="flex justify-between items-start">
                          <div>
                            <span className="text-[10px] font-mono font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-500/20">{ord.id}</span>
                            <h3 className="font-extrabold text-base text-white mt-1">{ord.product}</h3>
                            <p className="text-xs text-gray-300 mt-0.5">Cliente: <strong className="text-white">{ord.customer}</strong> ({ord.phone})</p>
                          </div>
                          <span className={`text-[10px] font-bold px-3 py-1 rounded-full border shrink-0 ${
                            ord.status === 'Confermato & Pagato' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' :
                            ord.status === 'In attesa di pagamento' ? 'bg-amber-500/20 text-amber-400 border-amber-500/40' :
                            'bg-red-500/20 text-red-400 border-red-500/40'
                          }`}>
                            {ord.status}
                          </span>
                        </div>

                        <div className="text-xs text-gray-300 space-y-1 bg-gray-950 p-3.5 rounded-2xl border border-gray-800/80">
                          <p>📅 Ritiro: <strong className="text-white">{ord.date}</strong> alle <strong className="text-white">{ord.time}</strong></p>
                          <p>📝 Note personalizzazione: <span className="text-gray-400 italic">{ord.notes}</span></p>
                        </div>
                      </div>

                      <div className="pt-3 border-t border-gray-800 flex items-center justify-between">
                        <div>
                          <span className="text-[11px] text-gray-400 block">Prezzo concordato</span>
                          <strong className="text-base text-amber-300">{ord.price ? `€ ${ord.price}` : 'Da calcolare'}</strong>
                        </div>

                        <div>
                          {!ord.price ? (
                            <button 
                              onClick={() => handleOpenQuoteModal(ord)}
                              className="bg-amber-500 hover:bg-amber-400 text-gray-950 font-bold px-4 py-2 rounded-xl text-xs shadow-lg transition"
                            >
                              Imposta Prezzo 💶
                            </button>
                          ) : !ord.isPaid ? (
                            <button 
                              onClick={() => handleSimulatePayment(ord.id)}
                              className="bg-teal-600 hover:bg-teal-500 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-lg transition"
                            >
                              Simula Incasso 💳
                            </button>
                          ) : (
                            <span className="text-xs text-emerald-400 font-bold flex items-center space-x-1 bg-emerald-500/10 px-3 py-1.5 rounded-xl border border-emerald-500/20">
                              <span>✅ Pagato Online</span>
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* SEZIONE 2: AGENDA LABORATORIO */}
            {activeTab === 'agenda' && (
              <div className="space-y-6">
                <div className="border-b border-gray-800 pb-4">
                  <h2 className="text-xl font-black text-white">Agenda Produzione Laboratorio</h2>
                  <p className="text-xs text-gray-400">Pianifica i volumi giornalieri di pane, lievitati e pasticceria fresca in base ai preordini confermati.</p>
                </div>

                <div className="bg-gray-900 border border-gray-800 rounded-3xl p-6 space-y-4 shadow-xl">
                  <h3 className="text-sm font-bold text-amber-400 uppercase tracking-wider">📅 Programma Giornaliero Forno</h3>
                  
                  <div className="space-y-3">
                    <div className="bg-gray-950 p-4 rounded-2xl border border-gray-800 flex flex-col md:flex-row md:items-center justify-between gap-2">
                      <div>
                        <strong className="text-white text-sm block">Pane Artigianale a Lievito Madre</strong>
                        <span className="text-xs text-gray-400">3 pagnotte grandi • Ritiro previsto ore 08:30</span>
                      </div>
                      <span className="bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-xl font-bold text-xs w-fit">In produzione</span>
                    </div>

                    <div className="bg-gray-950 p-4 rounded-2xl border border-gray-800 flex flex-col md:flex-row md:items-center justify-between gap-2">
                      <div>
                        <strong className="text-white text-sm block">Torta di Compleanno Personalizzata</strong>
                        <span className="text-xs text-gray-400">1 Torta cioccolato • Ritiro previsto domani ore 16:00</span>
                      </div>
                      <span className="bg-amber-500/20 text-amber-400 px-3 py-1 rounded-xl font-bold text-xs w-fit">Da preparare</span>
                    </div>

                    <div className="bg-gray-950 p-4 rounded-2xl border border-gray-800 flex flex-col md:flex-row md:items-center justify-between gap-2">
                      <div>
                        <strong className="text-white text-sm block">Vassoio Pasticceria Mista</strong>
                        <span className="text-xs text-gray-400">1.5 kg misto • Ritiro previsto domani ore 10:30</span>
                      </div>
                      <span className="bg-amber-500/20 text-amber-400 px-3 py-1 rounded-xl font-bold text-xs w-fit">Da preparare</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* SEZIONE 3: IMPOSTAZIONI NEGOZIO */}
            {activeTab === 'settings' && (
              <div className="space-y-6">
                <div className="border-b border-gray-800 pb-4">
                  <h2 className="text-xl font-black text-white">Configurazione Negozio & Link Vetrina</h2>
                  <p className="text-xs text-gray-400">Condividi il tuo link univoco sui social o su WhatsApp per permettere ai clienti di preordinare.</p>
                </div>

                <div className="bg-gray-900 border border-gray-800 rounded-3xl p-6 space-y-4 shadow-xl max-w-xl">
                  <h3 className="text-sm font-bold text-white">🌐 Link Dedicato per i Clienti</h3>
                  <div className="space-y-2">
                    <label className="text-xs font-semibold text-gray-400">Copia il link del tuo laboratorio:</label>
                    <div className="flex gap-2">
                      <input 
                        type="text" 
                        readOnly 
                        value="https://artisorder.app/pasticceria-centrale" 
                        className="flex-1 bg-gray-950 border border-gray-800 rounded-xl px-3 py-2.5 text-xs text-amber-300 font-mono"
                      />
                      <button 
                        onClick={() => alert("Link copiato negli appunti!")}
                        className="bg-amber-500 hover:bg-amber-400 text-gray-950 font-bold px-4 py-2.5 rounded-xl text-xs transition"
                      >
                        Copia
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            )}

          </main>

          {/* MODALE PREVENTIVO */}
          {selectedOrder && (
            <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
              <div className="bg-gray-900 border border-gray-800 rounded-3xl p-6 max-w-md w-full space-y-4 shadow-2xl relative">
                <button 
                  onClick={() => setSelectedOrder(null)}
                  className="absolute top-4 right-4 text-gray-400 hover:text-white font-bold text-sm bg-gray-800 w-8 h-8 rounded-full flex items-center justify-center"
                >
                  ✕
                </button>

                <div className="space-y-1">
                  <span className="text-amber-400 text-[10px] font-bold uppercase tracking-wider">Definizione Prezzo</span>
                  <h3 className="text-lg font-black text-white">{selectedOrder.product}</h3>
                  <p className="text-xs text-gray-400">Cliente: <strong className="text-white">{selectedOrder.customer}</strong></p>
                </div>

                <form onSubmit={handleSavePrice} className="space-y-4">
                  <div className="space-y-1">
                    <label className="text-xs font-semibold text-gray-300">Inserisci Prezzo Totale (€) *</label>
                    <input 
                      type="number" 
                      step="0.05"
                      required
                      placeholder="es. 35.00" 
                      value={priceInput}
                      onChange={(e) => setPriceInput(e.target.value)}
                      className="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 font-bold"
                    />
                  </div>

                  <p className="text-xs text-gray-400 italic bg-gray-950 p-3 rounded-xl border border-gray-800">
                    💡 Salvando, il sistema invierà automaticamente il preventivo al cliente sbloccando il pulsante per il pagamento online sicuro.
                  </p>

                  <button 
                    type="submit" 
                    className="w-full bg-amber-500 hover:bg-amber-400 text-gray-950 font-bold py-3 rounded-xl text-xs shadow-lg transition"
                  >
                    Invia Prezzo & Richiedi Pagamento 🚀
                  </button>
                </form>
              </div>
            </div>
          )}

        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<ArtisManagerApp />);
  </script>
</body>
</html>
