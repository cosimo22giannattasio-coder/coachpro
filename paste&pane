<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>ArtisOrder - Preordini Artigianali</title>
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { touch-action: manipulation; user-select: none; -webkit-user-select: none; }
  </style>
</head>
<body class="bg-gray-950 text-white font-sans antialiased selection:bg-amber-500 selection:text-black">
  <div id="root"></div>

  <script type="text/babel">
    const { useState } = React;

    function ArtisOrderApp() {
      const [activeTab, setActiveTab] = useState('catalog');
      const [selectedProduct, setSelectedProduct] = useState(null);
      const [orderSubmitted, setOrderSubmitted] = useState(false);
      
      // Stato del modulo d'ordine
      const [orderForm, setOrderForm] = useState({
        customerName: '',
        phone: '',
        date: '',
        time: '10:00',
        notes: '',
        quantity: '1 kg / 1 pezzo'
      });

      // Lista ordini inviati dal cliente (simulazione database locale)
      const [myOrders, setMyOrders] = useState([
        {
          id: 'ORD-8492',
          product: 'Torta di Compleanno Personalizzata',
          date: '2026-11-20',
          time: '16:00',
          status: 'In attesa di preventivo',
          price: null,
          notes: 'Scritta di augurio: "Buon Compleanno Marco" con decori al cioccolato.'
        }
      ]);

      const products = [
        { id: 1, category: 'Pasticceria', name: 'Torta su Misura / Compleanno', desc: 'Realizziamo la tua torta personalizzata per ogni occasione speciale.', icon: '🎂', priceInfo: 'Prezzo su misura' },
        { id: 2, category: 'Pasticceria', name: 'Vassoio Pasticceria Mista', desc: 'Paste fresche artigianali di produzione giornaliera.', icon: '🥐', priceInfo: '€ 28,00 / kg' },
        { id: 3, category: 'Panificio', name: 'Pane Artigianale a Lievito Madre', desc: 'Formati speciali, integrale, ai cereali o semola.', icon: '🍞', priceInfo: '€ 4,50 / kg' },
        { id: 4, category: 'Grandi Lievitati', name: 'Dolci Tradizionali & Feste', desc: 'Panettoni, colombe e focacce dolci artigianali.', icon: '🌾', priceInfo: 'Prezzo a partire da € 25' }
      ];

      const handleOpenOrder = (prod) => {
        setSelectedProduct(prod);
      };

      const handleSubmitOrder = (e) => {
        e.preventDefault();
        if (!orderForm.customerName || !orderForm.phone || !orderForm.date) {
          alert("Compila i campi obbligatori (Nome, Telefono e Data di ritiro).");
          return;
        }

        const newOrder = {
          id: 'ORD-' + Math.floor(1000 + Math.random() * 9000),
          product: selectedProduct.name,
          date: orderForm.date,
          time: orderForm.time,
          status: 'In attesa di preventivo',
          price: null,
          notes: orderForm.notes || 'Nessuna nota specifica.'
        };

        setMyOrders([newOrder, ...myOrders]);
        setOrderSubmitted(true);
        setTimeout(() => {
          setOrderSubmitted(false);
          setSelectedProduct(null);
          setActiveTab('orders');
          setOrderForm({ customerName: '', phone: '', date: '', time: '10:00', notes: '', quantity: '1 kg / 1 pezzo' });
        }, 1500);
      };

      return (
        <div className="min-h-screen bg-gray-950 text-gray-100 flex flex-col pb-24 relative max-w-md mx-auto border-x border-gray-900 shadow-2xl">
          
          {/* Header del Negozio */}
          <header className="bg-gray-900 border-b border-gray-800 p-4 sticky top-0 z-40 flex items-center justify-between">
            <div className="flex items-center space-x-3">
              <div className="w-10 h-10 bg-amber-500 text-gray-950 rounded-2xl font-black text-lg flex items-center justify-center shadow-lg shadow-amber-500/20">🌾</div>
              <div>
                <h1 className="font-bold text-sm text-white leading-tight">Il Forno & Pasticceria</h1>
                <span className="text-[10px] text-amber-400 font-medium">✨ Artigianale dal 1985 • Preordini Online</span>
              </div>
            </div>
            <div className="bg-gray-800 border border-gray-700 px-2.5 py-1 rounded-xl text-[10px] font-semibold text-emerald-400">
              🟢 Aperto ora
            </div>
          </header>

          {/* Contenuto Principale */}
          <main className="flex-1 p-4 space-y-4 overflow-y-auto">

            {/* SEZIONE 1: CATALOGO / VETRINA */}
            {activeTab === 'catalog' && (
              <div className="space-y-4">
                <div className="bg-gradient-to-r from-amber-950/40 to-amber-900/20 border border-amber-800/50 p-4 rounded-3xl space-y-1">
                  <h2 className="text-sm font-black text-amber-200">Ordina in anticipo, ritira senza attese</h2>
                  <p className="text-xs text-gray-300">Scegli il tuo prodotto artigianale, indica la data di ritiro e ricevi il preventivo direttamente sul telefono.</p>
                </div>

                <div className="space-y-3">
                  <h3 className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1">Seleziona Prodotto o Categoria</h3>
                  
                  {products.map(prod => (
                    <div 
                      key={prod.id} 
                      onClick={() => handleOpenOrder(prod)}
                      className="bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-amber-500/50 transition p-4 rounded-2xl flex items-center justify-between cursor-pointer shadow-md group"
                    >
                      <div className="flex items-center space-x-3.5">
                        <div className="w-12 h-12 bg-gray-800 rounded-2xl flex items-center justify-center text-2xl group-hover:scale-105 transition">
                          {prod.icon}
                        </div>
                        <div>
                          <span className="text-[10px] text-amber-400 font-bold uppercase">{prod.category}</span>
                          <h4 className="font-bold text-sm text-white">{prod.name}</h4>
                          <p className="text-[11px] text-gray-400 line-clamp-1">{prod.desc}</p>
                        </div>
                      </div>
                      <div className="text-right">
                        <span className="text-xs font-extrabold text-amber-300 block bg-amber-500/10 px-2 py-1 rounded-lg border border-amber-500/20">Richiedi</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* SEZIONE 2: I MIEI PREORDINI */}
            {activeTab === 'orders' && (
              <div className="space-y-4">
                <div className="flex items-center justify-between px-1">
                  <h3 className="text-sm font-bold text-white">I tuoi Preordini attivi</h3>
                  <span className="text-xs text-gray-400">{myOrders.length} ordini</span>
                </div>

                {myOrders.length === 0 ? (
                  <div className="text-center py-12 text-gray-500 text-xs">Non hai ancora effettuato nessun preordine.</div>
                ) : (
                  myOrders.map(ord => (
                    <div key={ord.id} className="bg-gray-900 border border-gray-800 rounded-2xl p-4 space-y-3 shadow-lg">
                      <div className="flex justify-between items-start border-b border-gray-800 pb-2">
                        <div>
                          <span className="text-[10px] font-mono font-bold text-gray-400">{ord.id}</span>
                          <h4 className="font-bold text-sm text-white">{ord.product}</h4>
                        </div>
                        <span className={`text-[10px] font-bold px-2.5 py-1 rounded-full border ${
                          ord.status === 'Pronto per il ritiro' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' :
                          ord.status === 'Confermato e Pagato' ? 'bg-teal-500/20 text-teal-300 border-teal-500/40' :
                          'bg-amber-500/20 text-amber-400 border-amber-500/40'
                        }`}>
                          {ord.status}
                        </span>
                      </div>

                      <div className="text-xs text-gray-300 space-y-1">
                        <p>📅 Ritiro: <strong className="text-white">{ord.date}</strong> alle <strong className="text-white">{ord.time}</strong></p>
                        <p>📝 Dettagli: <span className="text-gray-400 italic">{ord.notes}</span></p>
                      </div>

                      {ord.price ? (
                        <div className="bg-emerald-950/40 border border-emerald-800/60 p-3 rounded-xl flex items-center justify-between">
                          <span className="text-xs font-bold text-emerald-300">Totale Preventivo: {ord.price}</span>
                          <button onClick={() => alert("Simulazione pagamento online sicuro completata con successo!")} className="bg-emerald-500 hover:bg-emerald-400 text-gray-950 font-bold px-3 py-1.5 rounded-lg text-xs shadow">
                            Paga Ora Online 💳
                          </button>
                        </div>
                      ) : (
                        <div className="bg-gray-950 p-2.5 rounded-xl border border-gray-800 text-center">
                          <p className="text-[11px] text-amber-300 animate-pulse">⏳ Il laboratorio sta calcolando il prezzo. Riceverai presto notifica.</p>
                        </div>
                      )}
                    </div>
                  ))
                )}
              </div>
            )}

            {/* SEZIONE 3: INFO / CONTATTI */}
            {activeTab === 'info' && (
              <div className="space-y-4">
                <div className="bg-gray-900 border border-gray-800 p-4 rounded-2xl space-y-3">
                  <h3 className="text-sm font-bold text-white">📍 Dove Siamo & Orari</h3>
                  <p className="text-xs text-gray-300">Laboratorio artigianale di pane, lievitati e pasticceria fresca.</p>
                  <div className="text-xs text-gray-400 space-y-1 pt-2 border-t border-gray-800">
                    <p>🕒 Lun - Sab: 07:30 - 19:30</p>
                    <p>🕒 Domenica: 08:00 - 13:00</p>
                    <p>📞 Telefono / WhatsApp: +39 333 1234567</p>
                  </div>
                </div>
              </div>
            )}

          </main>

          {/* MODALE DI PREORDINE (COMPILAZIONE DATI CLIENTE) */}
          {selectedProduct && (
            <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
              <div className="bg-gray-900 border border-gray-800 rounded-3xl p-6 max-w-sm w-full space-y-4 shadow-2xl relative max-h-[90vh] overflow-y-auto">
                <button 
                  onClick={() => setSelectedProduct(null)}
                  className="absolute top-4 right-4 text-gray-400 hover:text-white font-bold text-sm bg-gray-800 w-8 h-8 rounded-full flex items-center justify-center"
                >
                  ✕
                </button>

                <div className="space-y-1">
                  <span className="text-amber-400 text-[10px] font-bold uppercase">{selectedProduct.category}</span>
                  <h3 className="text-lg font-black text-white">{selectedProduct.name}</h3>
                  <p className="text-xs text-gray-400">{selectedProduct.desc}</p>
                </div>

                {orderSubmitted ? (
                  <div className="bg-emerald-500/20 border border-emerald-500/40 p-6 rounded-2xl text-center space-y-2">
                    <div className="text-3xl">✅</div>
                    <h4 className="font-bold text-sm text-emerald-300">Preordine Inviato con Successo!</h4>
                    <p className="text-[11px] text-gray-300">Il negozio ha ricevuto la richiesta e ti invierà il prezzo a breve.</p>
                  </div>
                ) : (
                  <form onSubmit={handleSubmitOrder} className="space-y-3">
                    <div className="space-y-1">
                      <label className="text-xs font-semibold text-gray-300">Il tuo Nome e Cognome *</label>
                      <input 
                        type="text" 
                        required
                        placeholder="es. Mario Rossi" 
                        value={orderForm.customerName}
                        onChange={(e) => setOrderForm({...orderForm, customerName: e.target.value})}
                        className="w-full bg-gray-800 border border-gray-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500"
                      />
                    </div>

                    <div className="space-y-1">
                      <label className="text-xs font-semibold text-gray-300">Numero di Telefono (per WhatsApp) *</label>
                      <input 
                        type="tel" 
                        required
                        placeholder="es. 3331234567" 
                        value={orderForm.phone}
                        onChange={(e) => setOrderForm({...orderForm, phone: e.target.value})}
                        className="w-full bg-gray-800 border border-gray-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500"
                      />
                    </div>

                    <div className="grid grid-cols-2 gap-2">
                      <div className="space-y-1">
                        <label className="text-xs font-semibold text-gray-300">Data Ritiro *</label>
                        <input 
                          type="date" 
                          required
                          value={orderForm.date}
                          onChange={(e) => setOrderForm({...orderForm, date: e.target.value})}
                          className="w-full bg-gray-800 border border-gray-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500"
                        />
                      </div>
                      <div className="space-y-1">
                        <label className="text-xs font-semibold text-gray-300">Ora Ritiro</label>
                        <input 
                          type="time" 
                          value={orderForm.time}
                          onChange={(e) => setOrderForm({...orderForm, time: e.target.value})}
                          className="w-full bg-gray-800 border border-gray-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500"
                        />
                      </div>
                    </div>

                    <div className="space-y-1">
                      <label className="text-xs font-semibold text-gray-300">Note o Personalizzazioni</label>
                      <textarea 
                        placeholder="Es. Vorrei la scritta di buon compleanno, oppure 2 kg di pane ben cotto..."
                        value={orderForm.notes}
                        onChange={(e) => setOrderForm({...orderForm, notes: e.target.value})}
                        className="w-full bg-gray-800 border border-gray-700 rounded-xl px-3 py-2 text-xs text-white h-20 focus:outline-none focus:border-amber-500"
                      ></textarea>
                    </div>

                    <button 
                      type="submit" 
                      className="w-full bg-amber-500 hover:bg-amber-400 text-gray-950 font-bold py-3 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition"
                    >
                      Invia Richiesta Preordine 🚀
                    </button>
                  </form>
                )}

              </div>
            </div>
          )}

          {/* Barra di Navigazione Inferiore */}
          <nav className="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-gray-900/95 backdrop-blur-md border-t border-gray-800 px-6 py-2.5 flex justify-around items-center z-40">
            <button 
              onClick={() => setActiveTab('catalog')}
              className={`flex flex-col items-center space-y-1 ${activeTab === 'catalog' ? 'text-amber-400' : 'text-gray-400'}`}
            >
              <span className="text-xl">🥐</span>
              <span className="text-[10px] font-bold">Catalogo</span>
            </button>
            <button 
              onClick={() => setActiveTab('orders')}
              className={`flex flex-col items-center space-y-1 relative ${activeTab === 'orders' ? 'text-amber-400' : 'text-gray-400'}`}
            >
              <span className="text-xl">📦</span>
              <span className="text-[10px] font-bold">I Miei Ordini</span>
              {myOrders.length > 0 && (
                <span className="absolute -top-1 right-2 bg-amber-500 text-gray-950 font-black text-[9px] w-4 h-4 rounded-full flex items-center justify-center">
                  {myOrders.length}
                </span>
              )}
            </button>
            <button 
              onClick={() => setActiveTab('info')}
              className={`flex flex-col items-center space-y-1 ${activeTab === 'info' ? 'text-amber-400' : 'text-gray-400'}`}
            >
              <span className="text-xl">📍</span>
              <span className="text-[10px] font-bold">Negozio</span>
            </button>
          </nav>

        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<ArtisOrderApp />);
  </script>
</body>
</html>
